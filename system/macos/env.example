# Notion: create an internal integration, share your Flashcards database with it,
# then paste the integration token here.
NOTION_TOKEN=secret_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
NOTION_DATABASE_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# These names must match your Notion database properties exactly.
NOTION_STATUS_PROPERTY=Status
NOTION_READY_VALUE=Ready
NOTION_IMPORTED_VALUE=Imported
# Imported cards stay mirrored; missing Anki notes move to Needs review. Rejected cards are deleted.
NOTION_REJECTED_VALUE=Rejected
NOTION_MISSING_VALUE=Needs review
# Needs review is also used when an Imported note is missing from Anki.
NOTION_SYNC_STATUS_VALUES=Ready,Imported,Rejected
NOTION_QUESTION_PROPERTY=Question
NOTION_ANSWER_PROPERTY=Answer
NOTION_CLASS_PROPERTY=Class
NOTION_WEEK_PROPERTY=Week
NOTION_TOPIC_PROPERTY=Topic
NOTION_DECK_PROPERTY="Anki Deck"

# Used when a card has no Anki Deck property.
ANKI_DECK="Notion Cards"
ANKI_MODEL=Basic
ANKI_CONNECT_URL=http://127.0.0.1:8765
ANKI_WEEK_SUBDECKS=true
# After collection changes, ask AnkiConnect to sync the collection to AnkiWeb.
ANKIWEB_AUTO_SYNC=true
